# Не публикуйте этот файл с настоящим токеном.
BOT_TOKEN=
# Публичный HTTPS-адрес без завершающего / (после настройки сервера)
WEBAPP_URL=https://shop.example.com
# Личный ID администратора. Несколько: 123456789,987654321
ADMIN_IDS=
# ID личного чата менеджера или закрытой группы с ботом
MANAGER_CHAT_ID=0
# Продакшен: только false. Деморежим разрешает вход лишь с localhost.
DEV_MODE=false
DATA_DIR=/app/data
DOMAIN=shop.example.com
